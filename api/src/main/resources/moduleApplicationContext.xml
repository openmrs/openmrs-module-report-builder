<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns="http://www.springframework.org/schema/beans"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans-3.0.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context-3.0.xsd">

    <!-- Enable component scanning for legacy report configuration beans -->
    <context:component-scan base-package="org.openmrs.module.reportbuilder.legacyconfig" />

    <bean id="reportbuilder.HibernateReportBuilderDAO"
          class="org.openmrs.module.reportbuilder.api.db.hibernate.HibernateReportBuilderDAO">
        <property name="sessionFactory" ref="dbSessionFactory" />
    </bean>

    <bean id="reportbuilder.ReportBuilderService"
          class="org.springframework.transaction.interceptor.TransactionProxyFactoryBean">
        <property name="transactionManager" ref="transactionManager" />
        <property name="target">
            <bean class="org.openmrs.module.reportbuilder.api.impl.ReportBuilderServiceImpl">
                <property name="dao" ref="reportbuilder.HibernateReportBuilderDAO" />
            </bean>
        </property>
        <property name="preInterceptors" ref="serviceInterceptors" />
        <property name="transactionAttributeSource" ref="transactionAttributeSource" />
    </bean>

    <!-- Report Shipping Service - for exporting/shipping reports -->
    <bean id="reportbuilder.ReportShippingService"
          class="org.springframework.transaction.interceptor.TransactionProxyFactoryBean">
        <property name="transactionManager" ref="transactionManager" />
        <property name="target">
            <bean class="org.openmrs.module.reportbuilder.api.impl.ReportShippingServiceImpl">
                <property name="dao" ref="reportbuilder.HibernateReportBuilderDAO" />
            </bean>
        </property>
        <property name="preInterceptors" ref="serviceInterceptors" />
        <property name="transactionAttributeSource" ref="transactionAttributeSource" />
    </bean>

    <!-- Report Import Service - for importing reports -->
    <bean id="reportbuilder.ReportImportService"
          class="org.springframework.transaction.interceptor.TransactionProxyFactoryBean">
        <property name="transactionManager" ref="transactionManager" />
        <property name="target">
            <bean class="org.openmrs.module.reportbuilder.api.impl.ReportImportServiceImpl">
                <property name="dao" ref="reportbuilder.HibernateReportBuilderDAO" />
            </bean>
        </property>
        <property name="preInterceptors" ref="serviceInterceptors" />
        <property name="transactionAttributeSource" ref="transactionAttributeSource" />
    </bean>

    <bean parent="serviceContext">
        <property name="moduleService">
            <list>
                <value>org.openmrs.module.reportbuilder.api.ReportBuilderService</value>
                <ref bean="reportbuilder.ReportBuilderService" />
                <value>org.openmrs.module.reportbuilder.api.ReportShippingService</value>
                <ref bean="reportbuilder.ReportShippingService" />
                <value>org.openmrs.module.reportbuilder.api.ReportImportService</value>
                <ref bean="reportbuilder.ReportImportService" />
            </list>
        </property>
    </bean>
</beans>
        </preConditions>

        <createTable tableName="report_builder_report">
            <column name="report_builder_report_id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="uuid" type="CHAR(38)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="description" type="VARCHAR(255)"/>

            <column name="code" type="VARCHAR(100)"/>

            <!-- NEW: Report Type -->
            <column name="report_type" type="VARCHAR(30)" defaultValue="AGGREGATE">
                <constraints nullable="false"/>
            </column>

            <!-- NEW: Category -->
            <column name="category_id" type="INT"/>

            <column name="config_json" type="LONGTEXT"/>

            <column name="meta_json" type="LONGTEXT"/>

            <!-- Runtime artifact references -->
            <column name="compiled_report_definition_uuid" type="CHAR(38)"/>
            <column name="compiled_report_design_uuid" type="CHAR(38)"/>
            <column name="last_compiled_at" type="DATETIME"/>

            <!-- ENUM stored as STRING -->
            <column name="compile_status" type="VARCHAR(30)" defaultValue="DRAFT">
                <constraints nullable="false"/>
            </column>

            <!-- OpenMRS metadata fields -->
            <column name="creator" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="date_created" type="DATETIME">
                <constraints nullable="false"/>
            </column>

            <column name="changed_by" type="INT"/>
            <column name="date_changed" type="DATETIME"/>

            <column name="retired" type="BIT(1)" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <column name="retired_by" type="INT"/>
            <column name="date_retired" type="DATETIME"/>
            <column name="retire_reason" type="VARCHAR(255)"/>
        </createTable>

        <!-- ================= FKs ================= -->

        <addForeignKeyConstraint
                baseTableName="report_builder_report"
                baseColumnNames="creator"
                referencedTableName="users"
                referencedColumnNames="user_id"
                constraintName="fk_report_builder_report_creator"/>

        <addForeignKeyConstraint
                baseTableName="report_builder_report"
                baseColumnNames="changed_by"
                referencedTableName="users"
                referencedColumnNames="user_id"
                constraintName="fk_report_builder_report_changed_by"/>

        <addForeignKeyConstraint
                baseTableName="report_builder_report"
                baseColumnNames="retired_by"
                referencedTableName="users"
                referencedColumnNames="user_id"
                constraintName="fk_report_builder_report_retired_by"/>

        <!-- NEW FK: Category -->
        <addForeignKeyConstraint
                baseTableName="report_builder_report"
                baseColumnNames="category_id"
                referencedTableName="report_builder_report_category"
                referencedColumnNames="report_builder_report_category_id"
                constraintName="fk_report_builder_report_category"/>

        <!-- ================= INDEXES ================= -->

        <createIndex tableName="report_builder_report" indexName="idx_report_builder_report_uuid" unique="true">
            <column name="uuid"/>
        </createIndex>

        <createIndex tableName="report_builder_report" indexName="idx_report_builder_report_name">
            <column name="name"/>
        </createIndex>

        <createIndex tableName="report_builder_report" indexName="idx_report_builder_report_code">
            <column name="code"/>
        </createIndex>

        <createIndex tableName="report_builder_report" indexName="idx_report_builder_report_type">
            <column name="report_type"/>
        </createIndex>

        <createIndex tableName="report_builder_report" indexName="idx_report_builder_report_category">
            <column name="category_id"/>
        </createIndex>

        <createIndex tableName="report_builder_report" indexName="idx_report_builder_report_retired">
            <column name="retired"/>
        </createIndex>

        <createIndex tableName="report_builder_report" indexName="idx_report_builder_report_compile_status">

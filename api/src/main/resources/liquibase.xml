    <changeSet id="reportbuilder-20260722-00-fix-etl-source-fks" author="slubwama">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(*)
                FROM information_schema.key_column_usage
                WHERE constraint_name = 'fk_report_builder_etl_source_voided_by'
                AND table_schema = DATABASE()
                AND table_name = 'report_builder_etl_source'
            </sqlCheck>
        </preConditions>
        <!-- Drop any incorrectly named constraint if it exists -->
        <dropForeignKeyConstraint baseTableName="report_builder_etl_source"
                                  constraintName="fk_report_builder_etl_source_voided_by"/>
    </changeSet>

